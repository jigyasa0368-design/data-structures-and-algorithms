// Problem:  Trapping Rain Water 
// Platform: GFG
// Time Complexity: O(n)
// Space Complexity: O(1)
// Approach: 2 pointer


class Solution {
  public:
    int maxWater(vector<int> &arr) {
        // code here
        int leftmax=0,rightmax=0,ans=0;
        int l=0;
        int r=arr.size()-1;
        while(l<r){
            if(arr[l]<=arr[r]){
                if(leftmax>arr[l]){
                    ans+=leftmax-arr[l];
                }
                else{
                    leftmax=arr[l];
                }
                l++;
            }
            if(arr[l]>arr[r]){
                if(rightmax>arr[r]){
                    ans+=rightmax-arr[r];
                }
                else{
                    rightmax=arr[r];
                }
                r--;
            }
        }
        return ans;
    }
};
