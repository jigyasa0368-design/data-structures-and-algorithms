// Problem: Length of Last Word
// Platform: Leetcode
// Time Complexity: O(n)
// Space Complexity: O(1)
// Approach: nested if-else



class Solution {
public:
    int lengthOfLastWord(string s) {
        int i=s.size()-1;
        int cnt=0;
        while(i>=0){
            if(s[i]==' '){
                if(cnt>0){
                    break;
                }
            }
            else{
                cnt++;
            }
            i--;
        }
        return cnt;
    }
};
