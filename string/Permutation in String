// Problem: Permutation in String
// Platform: Leetcode
// Time Complexity: O(n)
// Space Complexity: O(1)
// Approach: sliding window


class Solution {
public:
    bool checkInclusion(string s1, string s2) {
        if (s1.size() > s2.size())
            return false;

        vector<int> s1Freq(26, 0);
        vector<int> windowFreq(26, 0);
        int k = s1.size();

        for (char ch : s1) {
            s1Freq[ch - 'a']++;
        }

        for (int i = 0; i < k; i++) {
            windowFreq[s2[i] - 'a']++;
        }

        if (s1Freq == windowFreq)
            return true;

        for (int r = k; r < s2.size(); r++) {
            windowFreq[s2[r] - 'a']++;
            windowFreq[s2[r - k] - 'a']--;

            if (s1Freq == windowFreq)
                return true;
        }

        return false;
    }
};
